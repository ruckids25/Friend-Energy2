# ==================================================
# OYOSHI Campaign Server — Environment Variables
# ==================================================
# Copy this file to .env and fill in the values
# ==================================================

# Facebook Webhook Verification Token
# (คุณตั้งเองได้ตามต้องการ — ใช้ตอน subscribe webhook ใน Facebook App Dashboard)
FB_VERIFY_TOKEN=oyoshi_good_energy_2024

# Facebook Page Access Token
# (ดูวิธี Generate ใน SETUP_GUIDE.md)
FB_PAGE_ACCESS_TOKEN=

# Facebook App Secret
# (หาได้จาก App Dashboard → Settings → Basic → App Secret)
FB_APP_SECRET=

# Facebook Page ID
# (หาได้จาก Page → About → Page ID หรือจาก Graph API Explorer)
FB_PAGE_ID=

# Server Port
PORT=3000

# ========== OPTIONAL ==========

# Campaign Post ID — ถ้าต้องการให้ Bot ตอบเฉพาะ Post นี้
# (ถ้าไม่ระบุ จะตอบทุก Post ของ Page)
# CAMPAIGN_POST_ID=

# Reply Delay (milliseconds) — delay ก่อนตอบเพื่อหลีกเลี่ยง spam filter
# Default: 3000 (3 วินาที)
REPLY_DELAY_MS=3000
